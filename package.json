{
  "name": "structure-atlas",
  "private": true,
  "description": "Workspace root for the Structure Atlas (see SPECIFICATION.md and ARCHITECTURE.md)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "build",
    "app"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "atlas": "npm run -w build atlas --",
    "build": "npm run -w build atlas",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run -w build atlas -- --check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
