{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The app is bundled by Vite, so it uses bundler-style resolution
    // (the build workspace stays on NodeNext — it runs directly under Node).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts"]
}
